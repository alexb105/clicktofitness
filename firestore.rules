rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to write to orders collection (for payments)
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.token.email in ['alexanderbonnici214@gmail.com'];
      allow write: if true; // Allow writes for payment processing
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 